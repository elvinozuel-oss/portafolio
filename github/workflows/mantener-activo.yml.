name: Mantener activo el portafolio

on:
  schedule:
    - cron: '17 9 * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Consultar la base de datos
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_KEY: ${{ secrets.SUPABASE_KEY }}
        run: |
          curl -fsS --retry 3 --retry-delay 10 "$SUPABASE_URL/rest/v1/profile?select=id" -H "apikey: $SUPABASE_KEY" -o /dev/null
          curl -fsS --retry 3 --retry-delay 10 "$SUPABASE_URL/rest/v1/tattoos?select=id&limit=1" -H "apikey: $SUPABASE_KEY" -o /dev/null
          echo "Base de datos activa"

      - name: Evitar que GitHub desactive este aviso por inactividad
        run: |
          last=$(git log -1 --format=%ct)
          now=$(date +%s)
          if [ $((now - last)) -gt 3888000 ]; then
            git config user.name "github-actions"
            git config user.email "github-actions@users.noreply.github.com"
            git commit --allow-empty -m "Mantener activo"
            git push
          fi
